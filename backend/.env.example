DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_db
PAYMENT_FAIL_SIMULATE=false

# Admin dashboard access gate
ADMIN_EMAIL=admin@shopvault.com
ADMIN_PASSWORD=admin123
ADMIN_ACCESS_KEY=shopvault-secret-key

# Stock threshold for dynamic badge coloring (stock <= threshold = Low Stock RED)
LOW_STOCK_THRESHOLD=4

# Historical seed data parameters
SEED_HISTORICAL_DAYS=30
SEED_RECORD_COUNT=25
